# ==============================================================================
# FileMate — Enterprise Git Ignore Specification
# ==============================================================================

# 1. Environment & Secret Credentials (NEVER commit live secrets)
.env
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
backend/.env
frontend/.env
secrets/
credentials/
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
*.id_rsa

# Whitelist safe template environment files ONLY
!.env.example
!*.env.example
!backend/.env.example
!frontend/.env.example

# 2. Executables, Application Packages & Binaries (STRICTLY FORBIDDEN)
*.exe
*.apk
*.aab
*.msi
*.msm
*.msp
*.dmg
*.pkg
*.app
*.ipa
*.deb
*.rpm
*.bin
*.dll
*.dylib
*.so
*.out
*.elf
*.iso
*.img
*.jar
*.war
*.ear

# 3. Database & Local Storage Files
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
db/*.db-wal
db/*.db-shm
backend/*.db
backend/*.db-wal
backend/*.db-shm
filemate.db

# Whitelist root db/filemate.db seed database for GitHub
!db/filemate.db
!db/.gitkeep

# 3. User Uploads & Local Media Artifacts
uploads/
backend/uploads/
backend/sample_receipts/uploads/
tmp/
temp/

# 4. Python & Virtual Environments
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/env/
backend/.venv/
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 5. Testing & Code Coverage
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/
.vitest/

# 6. Node / Frontend Dependencies & Builds
node_modules/
*/node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 7. IDE & Editor Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# 8. Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
