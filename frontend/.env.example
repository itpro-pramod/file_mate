# ==============================================================================
# FileMate Frontend Environment Configuration
# ==============================================================================
# NOTE: In Vite, only variables prefixed with VITE_ are exposed to the client.
# Never expose backend secrets, API keys, or JWT keys in this file.

# Backend API Base URL (empty string uses Vite dev server proxy or direct origin)
VITE_API_BASE_URL=http://localhost:8000

# Application Branding & Environment Metadata
VITE_APP_NAME=FileMate
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
