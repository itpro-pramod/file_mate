# ==============================================================================
# FileMate Backend Environment Configuration
# ==============================================================================

# Application Metadata
APP_NAME=FileMate
APP_ENV=development
DEBUG=true

# Database (SQLite in root db/ folder with WAL mode)
DATABASE_URL=sqlite:///./db/filemate.db

# Security & Authentication
SECRET_KEY=filemate_super_secret_jwt_signing_key_for_brightpath_enterprise_2026_prod_grade_998877
JWT_SECRET_KEY=filemate_super_secret_jwt_signing_key_for_brightpath_enterprise_2026_prod_grade_998877
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Dual LLM Provider Architecture: 'openai' or 'azure_openai'
LLM_PROVIDER=azure_openai

# Provider A: OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# Provider B: Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://digisofthubopenai.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini

# Guardrails & Timeouts
LLM_TIMEOUT_SECONDS=45
MAX_INPUT_LENGTH=2000
PENDING_ACTION_EXPIRY_MINUTES=10

# Observability & Logging
LOG_LEVEL=INFO

# Network & CORS Endpoints
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
